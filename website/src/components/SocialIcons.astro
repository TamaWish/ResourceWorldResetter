---
import DefaultSocialIcons from '@astrojs/starlight/components/SocialIcons.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const addOns = [
  ['PlaceholderAPI', `${base}/addons/placeholderapi/`],
  ['Discord', `${base}/addons/discord-webhook/`],
  ['Prometheus', `${base}/addons/prometheus/`],
  ['API', `${base}/addons/api/`],
];
---

<nav class="addon-nav" aria-label="RWR add-on wikis">
  {addOns.map(([label, href]) => <a {href}>{label}</a>)}
</nav>
<DefaultSocialIcons />

<style>
  .addon-nav { display: none; align-items: center; gap: 0.9rem; white-space: nowrap; }
  .addon-nav a { color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); font-weight: 600; text-decoration: none; }
  .addon-nav a:hover { color: var(--sl-color-text-accent); }
  @media (min-width: 72rem) { .addon-nav { display: flex; } }
</style>
